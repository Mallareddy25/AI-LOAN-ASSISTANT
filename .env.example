# ─────────────────────────────────────────────────────────────────────
# AI Loan Information Assistant (4SU24CS045) — environment template
# Copy to `.env` in the SERVER directory and fill in real values.
#   cp .env.example server/.env
# NEVER commit the real .env file. NEVER put the OpenAI key in client/.
# ─────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Comma-separated list of origins allowed to call the API in development
CLIENT_URL=http://localhost:5173

# ── MySQL ────────────────────────────────────────────────────────────
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=loan_assistant
DATABASE_CONNECTION_LIMIT=10

# Managed MySQL hosts (Aiven, PlanetScale) require TLS. Leave off for a local
# server. Set to true to encrypt; add DATABASE_SSL_CA to verify the certificate.
DATABASE_SSL=
DATABASE_SSL_CA=

# ── Authentication ───────────────────────────────────────────────────
# Generate a strong secret with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ── OpenAI (server side only — never exposed to the browser) ─────────
# Leave EMPTY to run in offline knowledge-base mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=900
OPENAI_TEMPERATURE=0.4
OPENAI_TIMEOUT_MS=30000

# ── AI behaviour ─────────────────────────────────────────────────────
# Number of prior conversation turns sent to the model for context
AI_CONTEXT_TURNS=10
# Hard cap on characters of retrieved knowledge-base context per question
AI_KB_CONTEXT_LIMIT=4000
# Maximum length (characters) of a single user chat message
CHAT_MAX_MESSAGE_LENGTH=2000

# ── Rate limiting ────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
CHAT_RATE_LIMIT_MAX=20

# ── Seed administrator (created by database/seed.sql) ────────────────
# Change this password immediately after first login.
SEED_ADMIN_EMAIL=admin@loanassistant.local
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_NAME=System Administrator

# ── Frontend (Vite — only VITE_ prefixed vars reach the browser) ─────
VITE_API_URL=http://localhost:5000/api
