# ---------------------------------------------------------------------------
# Copy to server/.env and fill in real values. Never commit a filled .env.
# Every value below is the default the app falls back to if it is absent.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5050
CLIENT_URL=http://localhost:5173

DATABASE_HOST=127.0.0.1
DATABASE_PORT=3307
DATABASE_USER=loan_app
DATABASE_PASSWORD=loan_app_pw
DATABASE_NAME=loan_assistant
DATABASE_CONNECTION_LIMIT=10

# Managed MySQL hosts (Aiven, PlanetScale) require TLS. Leave off for a local
# server. Set to true to encrypt; add DATABASE_SSL_CA to verify the certificate.
DATABASE_SSL=
DATABASE_SSL_CA=

JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=900
OPENAI_TEMPERATURE=0.4
OPENAI_TIMEOUT_MS=30000

AI_CONTEXT_TURNS=10
AI_KB_CONTEXT_LIMIT=4000
CHAT_MAX_MESSAGE_LENGTH=2000

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
CHAT_RATE_LIMIT_MAX=20

SEED_ADMIN_EMAIL=admin@loanassistant.local
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_NAME=System Administrator

VITE_API_URL=http://localhost:5050/api
