{
  "name": "loan-information-assistant-server",
  "version": "1.0.0",
  "private": true,
  "description": "Express REST API + AI service for the AI Loan Information Assistant (4SU24CS045)",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "lint": "eslint src ../api --ext .js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:create": "node scripts/createDatabase.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "db:setup": "npm run db:create && npm run db:migrate && npm run db:seed",
    "db:reset": "node scripts/reset.js && npm run db:seed"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.12.0",
    "openai": "^4.77.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "supertest": "^7.0.0",
    "vitest": "^2.1.8"
  }
}
